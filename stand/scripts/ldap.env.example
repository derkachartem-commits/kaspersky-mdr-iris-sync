# ============================================================================
#  LDAP для IRIS 3 — заполнить и сохранить рядом с install.sh как  ldap.env
#  Формат: KEY=VALUE, без кавычек, без пробелов вокруг '='.
#  Значения снять с существующего IRIS (см. README, шаг 3).
#  Все строки ниже, кроме закомментированных, попадут в .env нового стека.
# ============================================================================

# Включить LDAP-аутентификацию (установщик ставит это сам, если файл есть)
IRIS_AUTHENTICATION_TYPE=ldap

# --- сервер ---
LDAP_SERVER=dc1.example.local
LDAP_PORT=636
LDAP_USE_SSL=True
LDAP_TLS_VERSION=1.2

# --- вход пользователя: как собирается DN/логин ---
# AD: CORP\  + логин ; OpenLDAP: uid=
LDAP_USER_PREFIX=CORP\
# AD: ,OU=Users,DC=example,DC=local ; OpenLDAP: ,ou=people,dc=example,dc=local
LDAP_USER_SUFFIX=,OU=Users,DC=example,DC=local
# Тип аутентификации из конфигурации существующего инстанса (обычно search)
LDAP_AUTHENTICATION_TYPE=search

# --- сервисный аккаунт для поиска/провижининга ---
LDAP_SEARCH_DN=CN=svc_iris,OU=Service,DC=example,DC=local
LDAP_ATTRIBUTE_IDENTIFIER=sAMAccountName
LDAP_ATTRIBUTE_DISPLAY_NAME=displayName
LDAP_ATTRIBUTE_MAIL=mail

# --- TLS ---
# False — принимать любой серт (не рекомендуется); True — проверять
LDAP_VALIDATE_CERTIFICATE=True
# Имена файлов в iris/certificates/ldap/ (нужны при mTLS / приватном CA)
#LDAP_SERVER_CERTIFICATE=ldap_server.crt
#LDAP_PRIVATE_KEY=ldap_client.key
#LDAP_PRIVATE_KEY_PASSWORD=
#LDAP_CA_CERTIFICATE=corp_ca.crt
#LDAP_CUSTOM_TLS_CONFIG=True

# --- авто-создание пользователей при первом входе ---
IRIS_AUTHENTICATION_CREATE_USER_IF_NOT_EXIST=True
IRIS_NEW_USERS_DEFAULT_GROUP=Analysts
# Оставить локального администратора как аварийный вход
IRIS_AUTHENTICATION_LOCAL_FALLBACK=True
